server {
    server_name fgsfds.ai-info.ru;

    root /var/www/boardy/public;
    index index.php index.html;

    access_log /var/log/nginx/boardy-access.log;
    error_log  /var/log/nginx/boardy-error.log;

    #add_header Strict-Transport-Security "max-age=31536000" always;

    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg)$ {
    expires 7d;
    add_header Cache-Control "public, no-transform";
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    #location /cgi-bin/ {
    #    gzip off;
    #    root /var/www/boardy;
    #    fastcgi_pass unix:/var/run/fcgiwrap.socket;
    #    include fastcgi_params;
    #    fastcgi_param SCRIPT_FILENAME /var/www/boardy$fastcgi_script_name;
    #}

    location = /submit {
        gzip off;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/boardy/cgi-bin/submit.sh;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location /phpmyadmin {
    alias /usr/share/phpmyadmin;
    index index.php;

    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $request_filename;
        }
    }


    error_page 404 /404.html;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/ssl/boardy/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/ssl/boardy/privkey.pem; # managed by Certbot
}

server {
    if ($host = fgsfds.ai-info.ru) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name fgsfds.ai-info.ru;
    return 404; # managed by Certbot
}
